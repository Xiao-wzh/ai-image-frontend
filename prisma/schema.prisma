generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth 所需的标准模型
model User {
  id              String    @id @default(cuid())
  name            String?
  username        String?   @unique                  /// 用户名（唯一）
  email           String    @unique
  normalizedEmail String?   @unique                  /// 归一化邮箱（防别名重复注册）
  emailVerified DateTime?
  password      String?                            /// 加密后的密码
  image         String?                            /// 头像 URL
  credits       Int       @default(0)              /// 付费/常规积分（用户购买获得）
  bonusCredits  Int       @default(1000)           /// 赠送积分（默认赠送 1000=可生成5次）
  role          String    @default("USER")         /// 角色：USER / FINANCE / REVIEWER / ADMIN
  lastCheckIn   DateTime?                          /// 每日打卡时间
  
  // 推广邀请系统
  referralCode  String?   @unique                  /// 用户专属推广码
  invitedById   String?                            /// 邀请人ID
  invitedBy     User?     @relation("UserInvites", fields: [invitedById], references: [id])
  invites       User[]    @relation("UserInvites") /// 此用户邀请的所有用户
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  generations     Generation[]
  creditRecords   CreditRecord[]
  redemptionCodes RedemptionCode[] @relation("UserRedemptionCodes")
  appeals         Appeal[]
  watermarkTemplates WatermarkTemplate[]
  videoGenerations  VideoGeneration[]
  
  // 推广佣金记录
  referralRewardsGiven    ReferralRecord[] @relation("InviterRewards") /// 作为邀请人获得的佣金
  referralRewardsGenerated ReferralRecord[] @relation("InviteeRewards") /// 作为被邀请人产生的佣金

  productTypePrompts ProductTypePrompt[]

  // 代理系统
  agentLevel    Int       @default(0)    /// 代理等级: 0=普通用户, 1=推广员(L3), 2=运营中心(L2), 3=合伙人(L1)
  agentBalance  Int       @default(0)    /// 代理佣金余额(可提现)
  agentQuota    Int       @default(0)    /// L1专属: 剩余授权名额(初始5)

  commissionRecordsEarned   CommissionRecord[] @relation("EarnerCommissions")
  commissionRecordsGenerated CommissionRecord[] @relation("SourceCommissions")
  withdrawals               Withdrawal[]
  watermarkTasks            WatermarkTask[]
  copywritings              Copywriting[]
  orders                    Order[]             /// 用户的支付订单

  // 活动系统
  activityInviterRecords    ActivityReferral[]  @relation("ActivityInviterRecords") /// 作为邀请人的活动充值记录
  activityInviteeRecords    ActivityReferral[]  @relation("ActivityInviteeRecords") /// 作为被邀请人的活动充值记录
  activityRewardLogs        ActivityRewardLog[]                                     /// 活动奖励发放记录

  // VIP会员
  isVIP           Boolean   @default(false)    /// 是否VIP会员
  vipLevel        Int       @default(0)        // 0=无, 1=月卡Pro, 2=年卡Ultra (预留)
  vipValidUntil   DateTime?                    /// VIP有效期

  // 代理客制化配置
  agentProfile    Json?                        /// { siteName, welcomeMsg, contactQr }
}


// ============================================
// 商品套餐（统一管理积分包和VIP会员）
// ============================================

enum PlanType {
  CREDIT        // 积分充值包
  SUBSCRIPTION  // VIP订阅会员
}

model Plan {
  id            String    @id @default(cuid())
  name          String                          /// 商品名称
  description   String?                         /// 描述文案
  type          PlanType  @default(CREDIT)      /// 类型区分

  // 价格配置（单位：分）
  price         Int                             /// 售价
  originalPrice Int?                            /// 原价（划线价）

  // 权益配置
  credits       Int       @default(0)           /// 基础积分
  giftCredits   Int       @default(0)           /// 赠送积分
  duration      Int?                            /// 会员时长（天），仅 SUBSCRIPTION 有效
  features      Json?                           /// 其他权益配置

  isActive      Boolean   @default(true)        /// 是否上架
  isRecommend   Boolean   @default(false)       /// 是否推荐
  sortOrder     Int       @default(0)           /// 排序权重

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]

  @@index([type])
  @@index([isActive])
  @@index([sortOrder])
}


// 推广佣金记录
model ReferralRecord {
  id          String   @id @default(cuid())
  inviterId   String                              /// 邀请人ID（获得佣金的人）
  inviteeId   String                              /// 被邀请人ID（充值的人）
  amount      Int                                 /// 佣金金额（例如充值金额的10%）
  sourceType  String                              /// 来源类型：CDK / ALIPAY / WECHAT
  sourceId    String?                             /// 关联的订单ID或CDK码
  createdAt   DateTime @default(now())

  inviter     User     @relation("InviterRewards", fields: [inviterId], references: [id])
  invitee     User     @relation("InviteeRewards", fields: [inviteeId], references: [id])

  @@index([inviterId])
  @@index([inviteeId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// 邮箱验证码表（用于注册/登录验证）
model VerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String                                   /// 邮箱地址
  code      String                                   /// 6位验证码
  expires   DateTime                                 /// 过期时间
  createdAt DateTime @default(now())

  @@unique([email, code])
  @@index([email])
  @@index([expires])
}

/// 积分流水记录（用户可见的总变动：正数=入账，负数=消耗）
model CreditRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  amount      Int
  type        String
  description String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// 卡密/兑换码
model RedemptionCode {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  credits   Int
  bonus     Int
  status    String   @default("UNUSED")
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User? @relation("UserRedemptionCodes", fields: [usedBy], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([status])
  @@index([usedBy])
}

/// 平台（数据库驱动）
model Platform {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prompts ProductTypePrompt[]

  @@index([isActive, sortOrder])
}

// 我们的业务模型
model Generation {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String?  @unique /// 幂等键：前端生成的唯一请求ID，用于防重复提交
  userId          String?
  productName     String
  productType     String
  platformKey     String?  /// 仅记录：提交/重试时的 platformKey（不参与 prompt 查询）
  taskType        String   @default("MAIN_IMAGE") /// MAIN_IMAGE / DETAIL_PAGE
  mode            String   @default("CREATIVE")   /// CREATIVE / CLONE
  qualityMode     String   @default("STANDARD")   /// STANDARD / PRO
  features        String?  @db.Text               /// 卖点（克隆模式）
  refImages       String[]                        /// 参考图片（克隆模式）
  originalImage   String[]
  generatedImage  String?  @db.Text /// 存储完整的、未裁剪的原图 URL
  generatedImages String[] /// 存储九宫格切片图片 URL 数组
  editingImageIndexes Int[] @default([]) /// 正在编辑中的图片索引
  status                   String   @default("PENDING") /// PENDING / PROCESSING / COMPLETED / PARTIAL_SUCCESS / FAILED
  hasUsedDiscountedRetry Boolean @default(false)
  isWatermarkUnlocked    Boolean @default(false) /// 是否已解锁水印功能
  outputLanguage         String  @default("中文") /// 输出文字语言

  // PRO 模式参数
  imageCount      Int      @default(9)             /// PRO: 用户指定生成张数
  aspectRatio     String   @default("1:1")         /// PRO: 用户指定图片比例
  proFeatures     String?  @db.Text               /// PRO: 产品功能描述（可选）
  proStyle        String?  @db.Text               /// PRO: 画面风格描述（可选）

  // 资金快照（用于退款防坏账）
  costPerImage    Int      @default(0)             /// 单张成本快照 (PRO: >0, STANDARD: 0=按次计费)
  totalCost       Int      @default(0)             /// 本次总扣费快照
  refundAmount    Int      @default(0)             /// 已退款金额

  createdAt                DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  appeal Appeal? /// One-to-One: A generation can only be appealed once

  @@index([userId, createdAt(sort: Desc)]) // 覆盖 WHERE userId ORDER BY createdAt DESC
  @@index([userId, status])                // 覆盖 WHERE userId AND status IN (...)
  @@index([status])                        // 覆盖全局 status 统计
}


/// 商品类型与提示词模板映射表
model ProductTypePrompt {
  id             String   @id @default(uuid()) @db.Uuid

  // 关联平台（数据库驱动）
  platformId     String   @db.Uuid
  platform       Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  // 权限维度：UserId (空=所有人可用/系统默认，有值=该用户私有)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 业务维度：具体类别 Key (MENSWEAR, BEDDING)
  productType    String
  taskType       String   @default("MAIN_IMAGE") /// MAIN_IMAGE / DETAIL_PAGE
  mode           String   @default("CREATIVE")   /// CREATIVE / CLONE
  qualityMode    String   @default("STANDARD")   /// STANDARD / PRO

  // 内容
  promptTemplate String   @db.Text
  description    String?
  referenceImages String[] @default([])          /// 参考排版图片 URL 列表

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productType, taskType, mode, qualityMode, userId])
  @@index([platformId, productType, taskType, mode, qualityMode])
  @@index([userId])
}

/// 申诉记录（用户对生成结果不满意可发起申诉）
model Appeal {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String
  generationId   String   @unique @db.Uuid /// One-to-One: each generation can only have one appeal
  reason         String?  @db.Text         /// 用户申诉原因说明（可选）
  status         String   @default("PENDING") /// PENDING / PROCESSING / APPROVED / REJECTED / PENDING_MANUAL_REVIEW
  refundAmount   Int                        /// 退款积分数（创建时快照）
  adminNote      String?  @db.Text         /// 管理员备注（拒绝原因等）
  appealedImages String[] @default([])     /// 用户申诉的具体图片URL列表（按张申诉）

  // AI 自动审核相关字段
  aiConfidence   Float?                     /// AI 判决的置信度 (0.0 - 1.0)
  aiAnalysis     String?  @db.Text          /// AI 给出的具体判定理由（管理员可见）
  userMessage    String?  @db.Text          /// AI 给用户的简短提示（不超过20字，用户可见）
  reviewedBy     String   @default("AI")    /// 审核者：AI / MANUAL

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt(sort: Desc)]) // 优化申诉列表查询
}

/// 水印模板（用户预设）
model WatermarkTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String                         /// 模板名称
  type      String                         /// 类型：IMAGE / TEXT
  content   String   @db.Text              /// 图片URL 或 文本内容
  opacity   Int      @default(100)         /// 不透明度 0-100
  rotate    Int      @default(0)           /// 旋转角度 0-360
  scale     Int      @default(100)         /// 缩放比例 1-100
  position  String   @default("se")        /// TOS gravity: nw/north/ne/west/center/east/sw/south/se
  xOffset   Int      @default(10)          /// 水平边距（像素）
  yOffset   Int      @default(10)          /// 垂直边距（像素）
  isTiled   Boolean  @default(false)       /// 是否平铺
  fontSize  Int?                           /// 文本字号（仅type=TEXT）
  fontColor String?                        /// 文本颜色（仅type=TEXT，Hex格式 #FFFFFF）
  fontName  String?                        /// 字体名称（仅type=TEXT）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 系统公告（弹窗通知）
model SystemAnnouncement {
  id        String   @id @default(uuid()) @db.Uuid
  title     String                         /// 公告标题
  content   String   @db.Text              /// 公告内容（支持 Markdown）
  type      String   @default("NORMAL")    /// 类型：PINNED（置顶高亮）/ NORMAL（普通）
  isActive  Boolean  @default(true)        /// 是否启用
  sortOrder Int      @default(0)           /// 排序权重（越大越靠前）
  createdAt DateTime @default(now())

  @@index([isActive, type, sortOrder])
}

/// 代理佣金流水记录
model CommissionRecord {
  id            String   @id @default(cuid())
  earnerId      String                         /// 获得佣金的代理ID
  sourceUserId  String                         /// 产生消费的用户ID
  amount        Int                            /// 佣金金额
  rate          Int                            /// 佣金比例(12/5/3)
  level         Int                            /// 分润层级(1=直推/2=管理/3=顶级)
  orderId       String?                        /// 关联订单ID(CDK码或支付单号)
  orderType     String                         /// 订单类型: CDK / ALIPAY / WECHAT
  createdAt     DateTime @default(now())

  earner        User     @relation("EarnerCommissions", fields: [earnerId], references: [id])
  sourceUser    User     @relation("SourceCommissions", fields: [sourceUserId], references: [id])

  @@index([earnerId])
  @@index([sourceUserId])
  @@index([createdAt])
}

/// 代理提现记录
model Withdrawal {
  id          String   @id @default(cuid())
  userId      String                         /// 申请提现的代理ID
  amount      Int                            /// 提现金额
  status      String   @default("PENDING")   /// 状态: PENDING / APPROVED / REJECTED / COMPLETED
  bankInfo    String?  @db.Text              /// 收款账户信息(JSON: 银行/支付宝/微信)
  adminNote   String?                        /// 管理员备注
  processedAt DateTime?                      /// 处理时间
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

/// 去水印任务
model WatermarkTask {
  id            String    @id @default(cuid())
  userId        String
  originalUrl   String    @db.Text
  resultUrl     String?   @db.Text
  status        String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  errorMsg      String?
  remoteTaskId  String?   /// 远端 API 任务 ID（避免重复创建）
  refundedAt    DateTime? /// 退款时间（幂等控制）
  attemptsMade  Int       @default(0) /// Worker 处理次数
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// 系统配置表（Key-Value 动态配置）
model SystemConfig {
  key         String   @id              /// 配置键名（唯一标识）
  value       String                    /// 配置值（存储为字符串）
  description String?                   /// 配置说明（帮助管理员理解）
  updatedAt   DateTime @updatedAt       /// 最后更新时间
}

/// 智能文案生成记录
model Copywriting {
  id          String   @id @default(cuid())
  userId      String
  platform    String   // e.g. "SHOPEE"
  productName String
  content     String   @db.Text // Generated markdown
  cost        Int
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// 活动系统（JSON 驱动规则引擎）
// ============================================

/// 活动主表
model Activity {
  id        String         @id @default(cuid())
  name      String                              /// 活动名称
  startTime DateTime                            /// 活动开始时间
  endTime   DateTime                            /// 活动结束时间
  isActive  Boolean        @default(true)       /// 是否启用

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tiers               ActivityTier[]
  activityReferrals   ActivityReferral[]
  virtualLeaderboard  VirtualLeaderboard[]
  rewardLogs          ActivityRewardLog[]

  @@index([isActive, startTime, endTime])
}

/// 活动阶梯规则表（JSON 驱动，可扩展）
model ActivityTier {
  id         String   @id @default(cuid())
  activityId String                             /// 关联活动 ID
  tierLevel  Int                                /// 阶梯排序（1=最低，递增）
  /// 达标条件 JSON，例如：{ "minAmount": 1000, "minInvites": 0 }
  conditions Json
  /// 奖励内容 JSON，例如：{ "credits": 500, "vipDays": 0 }
  rewards    Json

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity   Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  rewardLogs ActivityRewardLog[]

  @@index([activityId, tierLevel])
}

/// 活动拉新充值记录（记录活动期间邀请人产生的充值明细）
model ActivityReferral {
  id             String   @id @default(cuid())
  activityId     String                         /// 关联活动 ID
  inviterId      String                         /// 邀请人用户 ID
  inviteeId      String                         /// 被邀请人用户 ID
  rechargeAmount Int                            /// 本次充值金额（分）
  orderId        String?                        /// 关联订单 ID（幂等控制）
  createdAt      DateTime @default(now())

  activity       Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  inviter        User     @relation("ActivityInviterRecords", fields: [inviterId], references: [id])
  invitee        User     @relation("ActivityInviteeRecords", fields: [inviteeId], references: [id])

  @@unique([activityId, orderId])
  @@index([activityId, inviterId])
  @@index([inviteeId])
}

/// 虚拟排行榜（管理员创建的气氛组数据）
model VirtualLeaderboard {
  id          String   @id @default(cuid())
  activityId  String                         /// 关联活动 ID
  fakeName    String                         /// 虚拟昵称
  fakeAvatar  String?                        /// 虚拟头像 URL
  fakeAmount  Int                            /// 虚拟充值金额（分）

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, fakeAmount])
}

/// 活动阶梯奖励发放记录（物理防重发：同一用户同一活动同一阶梯只能领一次）
model ActivityRewardLog {
  id             String   @id @default(cuid())
  userId         String                         /// 获奖用户（邀请人）ID
  activityId     String                         /// 关联活动 ID
  tierId         String                         /// 关联阶梯 ID
  rewardCredits  Int                            /// 实际发放的积分数量

  createdAt      DateTime @default(now())

  user           User         @relation(fields: [userId], references: [id])
  activity       Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tier           ActivityTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  /// 联合唯一索引：同一用户、同一活动、同一阶梯只允许发放一次
  @@unique([userId, activityId, tierId])
  @@index([activityId])
  @@index([userId])
}

/// 支付订单表（微信/支付宝等）
model Order {
  id                  String    @id @default(cuid())
  outTradeNo          String    @unique             /// 商户订单号（带渠道前缀，如 WX_xxx）
  channel             String    @default("wechat")  /// 支付渠道: wechat / alipay
  merchantKey         String                        /// 商户标识: mch_indi / mch_company
  mchid               String                        /// 微信商户号

  userId              String?                       /// 关联用户（可选，允许未登录下单）
  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  amount              Int                           /// 订单金额（分）
  currency            String    @default("CNY")     /// 货币类型
  title               String                        /// 订单标题/商品描述

  status              String    @default("CREATED") /// 状态: CREATED / PAYING / PAID / CLOSED / REFUND
  payPlatformTradeNo  String?                       /// 平台交易号（微信 transaction_id）
  paidAt              DateTime?                     /// 支付完成时间

  rawNotify           Json?                         /// 原始回调数据（用于排查）
  notifyProcessedAt   DateTime?                     /// 回调处理时间（幂等控制）

  expiredAt           DateTime?                     /// 订单过期时间（TODO: 支持自动关单）

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([merchantKey])
  @@index([createdAt])

  planId      String?                       /// 关联商品ID
  plan        Plan?     @relation(fields: [planId], references: [id])
  snapshot    Json?                         /// 下单时的商品快照

  @@index([planId])
}

/// 视频生成任务表
model VideoGeneration {
  id              String    @id @default(cuid())
  userId          String                          /// 用户ID
  taskId          String    @unique               /// 远程任务ID（云雾API返回）
  model           String                          /// 模型名称: sora-2, veo3, ...
  prompt          String    @db.Text              /// 视频描述
  seconds         Int       @default(10)          /// 视频时长（秒）
  size            String    @default("720x1280")  /// 分辨率
  referenceImage  String?   @db.Text              /// 参考图URL（可选，Sora-2 用）
  modelParams     Json?                           /// 模型特定参数（首尾帧、多图等，不同模型存不同结构）
  status          String    @default("PENDING")   /// 状态: PENDING / PROCESSING / COMPLETED / FAILED
  progress        Int       @default(0)           /// 进度百分比 0-100
  videoUrl        String?   @db.Text              /// 生成的视频URL
  errorMsg        String?                         /// 错误信息
  cost            Int       @default(0)           /// 实际消耗积分（seconds × costPerSecond）
  costPerSecond   Int       @default(0)           /// 快照：创建时的每秒单价
  hasRefunded     Boolean   @default(false)       /// 是否已退款（防重复退款）
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?                       /// 完成时间

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([taskId])
  @@index([createdAt])
}
